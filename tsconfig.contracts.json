{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "contracts/**/*.ts",
    "src/lib/server/**/*.ts",
    "scripts/contracts.ts",
    "scripts/validate_contract_fixture.ts",
    "tests/**/*.ts",
    "scripts/example_request.ts",
    "scripts/check_api.ts"
  ]
}
