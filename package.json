{
	"name": "hackmidwest-2026",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"test": "npm run contracts:check && npm run contracts:types && npm run test:reference && node --test tests/*.test.ts",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"contracts:generate": "node scripts/contracts.ts && node scripts/example_request.ts && node scripts/monte_carlo_contracts.ts",
		"contracts:check": "node scripts/contracts.ts --check && node scripts/example_request.ts --check && node scripts/monte_carlo_contracts.ts --check",
		"fixture:contract": "node scripts/validate_contract_fixture.ts",
		"contracts:types": "tsc -p tsconfig.contracts.json",
		"test:api:live": "node scripts/check_api.ts",
		"test:reference": "node scripts/generate_reference_result.ts --check"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.19.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"zod": "^4.6.5"
	}
}
