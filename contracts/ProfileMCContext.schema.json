{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "binding_version": {
      "type": "string",
      "const": "profile-mc-binding-1-candidate"
    },
    "company": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "profile_version": {
          "type": "string",
          "const": "company-profile-2-draft"
        },
        "mapping_version": {
          "type": "string",
          "const": "company-mapping-2-draft"
        },
        "profile_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compiled_company_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "profile_id",
        "revision",
        "profile_version",
        "mapping_version",
        "profile_fingerprint",
        "compiled_company_fingerprint"
      ],
      "additionalProperties": false
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "binding_version",
    "company",
    "input_fingerprint",
    "config_fingerprint"
  ],
  "additionalProperties": false
}
